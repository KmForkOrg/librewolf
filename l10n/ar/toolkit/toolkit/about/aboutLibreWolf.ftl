about-librewolf-title = كتاب LibreWolf، ‏10:22
about-librewolf-quote =
    بعدما سقطت <em>قلعة</em> ‏Indus، بعض متّبعين <em>الثعلب</em> تُركوا.
    بينما <em>الكلب المنقذ</em> أنقذ <em>الذئب</em> من العاصفة، استمر <em>الثعلب</em> بالإرتجاف بالوهم.
about-librewolf-from = من <strong>‏ كتاب ‏‎،LibreWolf‏</strong> ‏10:22
