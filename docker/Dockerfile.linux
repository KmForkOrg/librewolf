FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3-pip rpm gnupg jq nodejs ruby git-lfs curl xz-utils pigz \
        file appstream binutils tar make unzip ca-certificates patch s3cmd && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    gem install fpm && gem cleanup

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
        sh -s -- -y --profile minimal --default-toolchain 1.99.1 --target aarch64-unknown-linux-gnu

RUN curl -qfLA "" --no-sessionid --proto =https --tlsv1.2 \
        "https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-x86_64.AppImage" -o "appimagetool" && \
    printf '%s  %s\n' 'ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0' 'appimagetool' | sha256sum -c - && \
    chmod +x appimagetool && \
    mv appimagetool /usr/local/bin/

RUN curl -qfLA "" --no-sessionid --proto =https --tlsv1.2 \
        "https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-aarch64" -o "runtime-aarch64" \
        "https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-x86_64" -o "runtime-x86_64" && \
    printf '%s  %s\n' '00cbdfcf917cc6c0ff6d3347d59e0ca1f7f45a6df1a428a0d6d8a78664d87444' 'runtime-aarch64' | sha256sum -c - && \
    printf '%s  %s\n' '2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d' 'runtime-x86_64' | sha256sum -c - && \
    mv runtime-x86_64 /usr/local/lib/appimage-runtime-x86_64 && \
    mv runtime-aarch64 /usr/local/lib/appimage-runtime-aarch64

ARG FORGE_URL
ARG FORGE_REPO_OWNER
ARG VERSION
ARG PUBKEY

RUN curl -qfA "" --no-sessionid --proto =https --tlsv1.2 \
        ${FORGE_URL}/api/packages/${FORGE_REPO_OWNER}/generic/librewolf-source/${VERSION}/librewolf-${VERSION}.source.tar.gz -o librewolf-${VERSION}.source.tar.gz \
        ${FORGE_URL}/api/packages/${FORGE_REPO_OWNER}/generic/librewolf-source/${VERSION}/librewolf-${VERSION}.source.tar.gz -o librewolf-${VERSION}.source.tar.gz.sig && \
    printf '%s' "$PUBKEY" | gpg --import && \
    gpg --verify librewolf-${VERSION}.source.tar.gz.sig librewolf-${VERSION}.source.tar.gz && \
    tar -xf librewolf-${VERSION}.source.tar.gz && \
    # Download needed build artifacts
    ./librewolf-${VERSION}/mach artifact toolchain --from-build \
        linux64-clang-23 sysroot-x86_64-linux-gnu linux64-pkgconf \
        linux64-cbindgen linux64-node-24 linux64-nasm sysroot-wasm32-wasi-clang-23 \
        onnxruntime-x86_64-linux-gnu sysroot-aarch64-linux-gnu && \
    # Move artifacts to .mozbuild
    mv  clang sysroot-x86_64-linux-gnu pkgconf \
        cbindgen node nasm sysroot-wasm32-wasi \
        onnxruntime-x86_64-linux-gnu sysroot-aarch64-linux-gnu
        /root/.mozbuild/ && \
    # Cleanup
    rm -rf \
        librewolf-${VERSION}.source.tar.gz \
        librewolf-${VERSION}.source.tar.gz.sig \
        /root/.mozbuild/toolchains librewolf-${VERSION} \
        /root/.mozbuild/srcdirs /root/.mozbuild/mach_func_cache \
        /root/.mozbuild/glean /root/.cache \
        /root/.gnupg
